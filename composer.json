{
  "name": "bebel/router",
  "description": "BebelRouter: biblioteca profissional de roteamento HTTP PHP puro, inspirada na API do Laravel.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "bebelrouter",
    "router",
    "routing",
    "http",
    "middleware",
    "psr-4"
  ],
  "homepage": "https://github.com/valtercoutojunior/bebel-router",
  "support": {
    "issues": "https://github.com/valtercoutojunior/bebel-router/issues",
    "source": "https://github.com/valtercoutojunior/bebel-router"
  },
  "authors": [
    {
      "name": "Valter Couto Santos Junior",
      "email": "valter.couto.s.junior@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "BebelRouter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BebelRouter\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "stan": "vendor/bin/phpstan analyse src tests --level=max --memory-limit=512M"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}